{
  "openapi": "3.1.0",
  "info": {
    "title": "CargoBox API",
    "description": "\nAPI de **CargoBox — Plataforma de Envíos Nacionales** (Caso 14, PIA Componentes de Lógica de Negocios).\n\nImplementa las 15 historias de usuario del BRD con DDD, Specification y State Machine.\nCada endpoint indica su historia (US) en el título. Los errores de negocio responden con\n`{\"error\": \"...\", \"mensaje\": \"...\"}` en lenguaje entendible para el cliente.\n",
    "version": "1.0.0"
  },
  "paths": {
    "/guias": {
      "post": {
        "tags": [
          "Guías"
        ],
        "summary": "US01 · Registrar un envío y generar su guía",
        "operationId": "registrar_guia_guias_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrarGuiaIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuiaOut"
                }
              }
            }
          },
          "404": {
            "description": "La guía no existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "409": {
            "description": "Una regla del negocio no lo permite",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Datos inválidos o incompletos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        }
      }
    },
