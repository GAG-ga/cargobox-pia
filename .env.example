# Copiar a .env y ajustar. NUNCA subir .env al repositorio (está en .gitignore).

# --- Base de datos (docker compose) ---
POSTGRES_USER=cargobox
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=cargobox

# --- Aplicación ---
# Local sin Docker: si no se define, se usa SQLite (sqlite:///./cargobox.db)
# En Render se usa la "Internal Database URL" que da la plataforma.
DATABASE_URL=postgresql+psycopg://cargobox:cambia-esta-clave@db:5432/cargobox
APP_ENV=local
EVIDENCIAS_DIR=/data/evidencias
